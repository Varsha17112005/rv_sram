# compile verilog/system verilog design source files
verilog xil_defaultlib  "../../../../project_riscv/project_riscv.srcs/sources_1/new/sram.v"
sv xil_defaultlib  "../../../../project_riscv/project_riscv.srcs/sources_1/new/sram_wrap.sv"
